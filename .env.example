# Copy this file to .env and fill only the providers you use.
# Never commit the populated .env file.
# The offline fixture smoke test does not require any value in this file.

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=1

# Tavily web search
TAVILY_API_KEY=

# Optional OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_MODEL=
MIMO_API_KEY=
MIMO_MODEL=
VLLM_API_KEY=EMPTY
VLLM_MODEL=

# Optional release/version marker recorded in run metadata
RESEARCH_ENGINE_VERSION=v1.0.0
